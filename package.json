{
  "name": "seed-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "package:mac": "node scripts/package-mac.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test": "cd src-tauri && cargo test",
    "devserver": "cd src-tauri && cargo run --features devserver --bin devserver"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xyflow/react": "^12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "typescript": "^5",
    "vite": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awsnasser/seed-studio.git"
  },
  "packageManager": "pnpm@10.33.2"
}
